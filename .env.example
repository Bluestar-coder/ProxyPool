# ProxyPool environment configuration
# Copy this file to .env and adjust the values.
# .env is gitignored and will never be committed.

# ── Data storage ──────────────────────────────────────────────────────────────
# Override the directory where proxies.db is stored.
# Default (macOS): ~/Library/Application Support/ProxyPool/
# Default (Windows): %APPDATA%\ProxyPool\
# PROXYPOOL_DATA_DIR=/path/to/custom/data/dir

# Override the full path to the SQLite database file.
# Takes precedence over PROXYPOOL_DATA_DIR when both are set.
# PROXYPOOL_DB_PATH=/path/to/custom/proxies.db

# ── Logging ───────────────────────────────────────────────────────────────────
# Log verbosity: DEBUG | INFO | WARNING | ERROR  (default: INFO)
# PROXYPOOL_LOG_LEVEL=DEBUG

# ── Service ports ─────────────────────────────────────────────────────────────
# These override the values stored in the database (Settings UI).
# Useful for quickly changing ports without opening the app.
# PROXYPOOL_SOCKS_PORT=51024
# PROXYPOOL_REST_PORT=51025
# PROXYPOOL_HTTP_PORT=51026

# ── Validator ─────────────────────────────────────────────────────────────────
# PROXYPOOL_VALIDATOR_CONCURRENCY=50
# PROXYPOOL_VALIDATOR_TIMEOUT=15
# PROXYPOOL_VALIDATOR_ENDPOINT=http://ip-api.com/json
